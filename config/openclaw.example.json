  "agents": {
    "defaults": {
      "workspace": "__WORKSPACE_DIR__",
      "model": {
        "primary": "cerebras/moonshotai-kimi-k3.1-pro-trial"
      },
      "skipOptionalBootstrapFiles": [
        "SOUL.md",
        "USER.md",
        "HEARTBEAT.md",
        "IDENTITY.md"
      ],
      "startupContext": {
        "enabled": false
      },
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "5m"
      },
      "thinkingDefault": "low",
      "reasoningDefault": "off"
    }
  },
  "skills": {
    "allowBundled": [
      "minecraft-harness"
    ]
  },
  "tools": {
    "profile": "minimal",
    "alsoAllow": [
      "bundle-mcp",
      "minecraft-harness__*"
    ],
    "deny": [
      "session_status"
    ]
  },
  "mcp": {
    "servers": {
      "minecraft-harness": {
        "enabled": true,
        "transport": "streamable-http",
        "url": "http://127.0.0.1:25581/mcp",
        "supportsParallelToolCalls": true
      }
    }
  }
