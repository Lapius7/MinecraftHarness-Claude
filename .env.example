# Copy this file to `.env` in the project root (or `.openclaw-home/.openclaw/.env`)
# and fill in the API key for your chosen provider.

# Cerebras API key (https://cloud.cerebras.ai/)
CEREBRAS_API_KEY=

# Optional: Command Code API key (if using `.\set-provider.ps1 commandcode`)
# CMD_API_KEY=

# Optional: Agent runtime mode (`openclaw` default; set `direct` to run standalone without OpenClaw Gateway)
# MH_AGENT_MODE=openclaw

# Optional: Default reasoning effort (`low` | `medium` | `high` | `off`)
# MH_THINKING=low

# Optional: Auto-failover provider ID if upstream 429 retries exhaust (e.g. `commandcode`)
# MH_FALLBACK_PROVIDER=
