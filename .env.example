# Copy this file to `.env` in the project root (or `.openclaw-home/.openclaw/.env`)
# and fill in the API key for your chosen provider.

# Cerebras API key (https://cloud.cerebras.ai/)
CEREBRAS_API_KEY=

# Optional: Command Code API key (if using `.\set-provider.ps1 commandcode` or `/mh model commandcode`)
# CMD_API_KEY=

# Optional: OpenDesign Go API key for DeepSeek V4.1 Flash (`/mh model opendesign`)
# OPENDESIGN_API_KEY=
# Optional override if using a custom/local OpenDesign endpoint (default: https://amr-link.open-design.ai/v1)
# OPENDESIGN_BASE_URL=https://amr-link.open-design.ai/v1

# Optional: OpenCode Go API key (`/mh model opencode-go`, default base: https://opencode.ai/zen/go/v1)
# (Also accepts OPENCODE_API_KEY if OPENCODE_GO_API_KEY is unset)
# OPENCODE_GO_API_KEY=
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# Optional: OpenRouter API key (`/mh model openrouter` or `/mh model openrouter/<any-model-id>`)
# OPENROUTER_API_KEY=

# Optional: Agent runtime mode (`openclaw` default; set `direct` to run standalone without OpenClaw Gateway)
# MH_AGENT_MODE=openclaw

# Optional: Default reasoning effort (`low` | `medium` | `high` | `off`)
# MH_THINKING=low

# Optional: Auto-failover provider ID if upstream 429 retries exhaust (e.g. `commandcode`)
# MH_FALLBACK_PROVIDER=
